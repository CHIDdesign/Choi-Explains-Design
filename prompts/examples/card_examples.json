  "html": "<div class=\"card\" data-card-id=\"ob\"><style>\n.card[data-card-id=\"ob\"] .root{width:100%;height:100%;position:relative;overflow:hidden;background:var(--paper)}\n.card[data-card-id=\"ob\"] .grid{position:absolute;inset:0;background-image:linear-gradient(var(--paper-line) 1px,transparent 1px),linear-gradient(90deg,var(--paper-line) 1px,transparent 1px);background-size:60px 60px;opacity:.55}\n.card[data-card-id=\"ob\"] .panel{position:absolute;left:120px;top:110px;width:820px;height:760px;border-radius:36px;background:var(--white);box-shadow:0 30px 70px -30px rgba(18,19,21,.28),0 2px 6px rgba(18,19,21,.06)}\n.card[data-card-id=\"ob\"] svg.obj{position:absolute;left:150px;top:150px;width:760px;height:680px}\n.card[data-card-id=\"ob\"] .h{position:absolute;left:1040px;top:120px;margin:0;width:760px;font-family:var(--font-head);font-weight:800;font-size:92px;line-height:1.05;letter-spacing:-.04em;color:var(--ink)}\n.card[data-card-id=\"ob\"] .h em{font-family:var(--font-italic);font-style:italic;font-weight:400;color:var(--accent-deep)}\n.card[data-card-id=\"ob\"] .lab{position:absolute;left:1040px;width:720px;font-family:var(--font-body);font-size:38px;font-weight:600;color:var(--ink);display:flex;gap:22px;align-items:baseline}\n.card[data-card-id=\"ob\"] .lab i{font-family:var(--font-italic);font-style:italic;font-weight:400;font-size:44px;color:var(--accent-deep);width:54px}\n.card[data-card-id=\"ob\"] .lab span{font-weight:500;color:var(--ink-soft);font-size:32px}\n.card[data-card-id=\"ob\"] svg.lead{position:absolute;left:0;top:0;width:1920px;height:1080px;pointer-events:none}\n</style><div class=\"root\"><div class=\"grid\"></div><div class=\"panel\"></div>\n<svg class=\"obj\" viewBox=\"0 0 760 680\">\n<g fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n<path class=\"d\" d=\"M250 230 H510 L478 600 H282 Z\"/>\n<path class=\"d\" d=\"M232 230 H528 C 528 200, 510 186, 488 186 H272 C 250 186, 232 200, 232 230\"/>\n<path class=\"d\" d=\"M268 330 H492\"/>\n<path class=\"d\" d=\"M402 186 L 452 70\" stroke=\"var(--accent)\" stroke-width=\"12\"/>\n<path class=\"d\" d=\"M300 186 C 330 170, 360 170, 380 186\" stroke-width=\"5\"/>\n</g></svg>\n<svg class=\"lead\" viewBox=\"0 0 1920 1080\"><g fill=\"none\" stroke=\"var(--ink-soft)\" stroke-width=\"3\">\n<path class=\"l1\" d=\"M590 260 C 760 250, 880 330, 1020 352\"/><path class=\"l2\" d=\"M560 340 C 760 380, 880 492, 1020 512\"/><path class=\"l3\" d=\"M630 560 C 790 600, 900 662, 1020 672\"/></g>\n<g fill=\"var(--accent)\"><circle class=\"p1\" cx=\"590\" cy=\"260\" r=\"10\"/><circle class=\"p2\" cx=\"560\" cy=\"340\" r=\"10\"/><circle class=\"p3\" cx=\"630\" cy=\"560\" r=\"10\"/></g></svg>\n<h2 class=\"h\">닮은 건<br><em>세 군데</em>였다</h2>\n<div class=\"lab\" style=\"top:328px\"><i>01</i>빨대<span>금지해도 다시 그렸다</span></div>\n<div class=\"lab\" style=\"top:488px\"><i>02</i>뚜껑 홈<span>예시의 모양 그대로</span></div>\n<div class=\"lab\" style=\"top:648px\"><i>03</i>몸통 띠<span>예시에만 있던 장식</span></div>\n</div></div>",
  "timeline": "const glide = gsap.customEase('M0,0 C0.12,0.9 0.2,1 1,1');\nconst head = gsap.splitText('.h', {type: 'words', mask: 'words'});\ntl.from(q('.panel'), {y: 40, opacity: 0, duration: 0.8, ease: glide}, 0);\ntl.fromTo(q('.obj .d'), {drawSVG: '0% 0%'}, {drawSVG: '0% 100%', duration: 1.1, ease: 'power2.inOut', stagger: 0.12}, 0.1);\ntl.from(head.words, {yPercent: 110, duration: 0.75, ease: glide, stagger: 0.06}, 0.15);\nconst rows = [['.l1', '.p1', 0], ['.l2', '.p2', 1], ['.l3', '.p3', 2]];\nrows.forEach(([l, p, i]) => {\n  const at = 1.4 + i * 0.75;\n  tl.from(q(p), {scale: 0, transformOrigin: '50% 50%', duration: 0.35, ease: 'back.out(1.6)'}, at);\n  tl.fromTo(q(l), {drawSVG: '0% 0%'}, {drawSVG: '0% 100%', duration: 0.6, ease: 'power2.inOut'}, at + 0.05);\n  tl.from(q('.lab')[i], {x: -24, opacity: 0, duration: 0.55, ease: glide}, at + 0.4);\n});\ntl.to(q('.obj'), {rotation: -1.5, y: -10, duration: 4, ease: 'sine.inOut', transformOrigin: '50% 80%'}, 1.5);"
 },
