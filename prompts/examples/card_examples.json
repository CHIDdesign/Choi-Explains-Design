  "html": "<div class=\"card\" data-card-id=\"fs\"><style>\n.card[data-card-id=\"fs\"] .root{width:100%;height:100%;position:relative;overflow:hidden;background:var(--ink)}\n.card[data-card-id=\"fs\"] .h{position:absolute;left:140px;top:150px;width:700px;margin:0;font-family:var(--font-head);font-weight:800;font-size:110px;line-height:1.03;letter-spacing:-.045em;color:#F4F4F2}\n.card[data-card-id=\"fs\"] .h em{font-family:var(--font-italic);font-style:italic;font-weight:400;color:var(--accent-light)}\n.card[data-card-id=\"fs\"] .sub{position:absolute;left:144px;top:560px;width:600px;font-family:var(--font-body);font-weight:500;font-size:38px;line-height:1.4;color:rgba(244,244,242,.72)}\n.card[data-card-id=\"fs\"] .deck{position:absolute;left:1130px;top:200px;width:440px;height:580px}\n.card[data-card-id=\"fs\"] .pc{position:absolute;left:0;top:0;width:440px;height:580px;border-radius:26px;background:var(--white);box-shadow:0 30px 60px -20px rgba(0,0,0,.55);transform-origin:50% 120%}\n.card[data-card-id=\"fs\"] .pc svg{position:absolute;left:90px;top:110px;width:260px;height:340px}\n.card[data-card-id=\"fs\"] .pc .n{position:absolute;left:30px;top:24px;font-family:var(--font-italic);font-style:italic;font-size:40px;color:rgba(18,19,21,.55)}\n.card[data-card-id=\"fs\"] .pc.hi{outline:8px solid var(--accent)}\n.card[data-card-id=\"fs\"] .pc.hi .n{color:var(--accent-deep)}\n</style><div class=\"root\">\n<h2 class=\"h\">스무 장 모두<br><em>같은 컵</em></h2>\n<p class=\"sub\">빨대를 빼라고 했는데도 빨대가 남았다</p>\n<div class=\"deck\">\n<div class=\"pc\"><span class=\"n\">no.5</span><svg viewBox=\"0 0 260 340\"><g fill=\"none\" stroke=\"#121315\" stroke-width=\"7\" stroke-linecap=\"round\"><path d=\"M40 70 H220 L200 320 H60 Z\"/><path d=\"M30 70 H230\"/><path d=\"M150 70 L190 10\"/></g></svg></div>\n<div class=\"pc\"><span class=\"n\">no.4</span><svg viewBox=\"0 0 260 340\"><g fill=\"none\" stroke=\"#121315\" stroke-width=\"7\" stroke-linecap=\"round\"><path d=\"M40 70 H220 L200 320 H60 Z\"/><path d=\"M30 70 H230\"/><path d=\"M150 70 L190 10\"/></g></svg></div>\n<div class=\"pc\"><span class=\"n\">no.3</span><svg viewBox=\"0 0 260 340\"><g fill=\"none\" stroke=\"#121315\" stroke-width=\"7\" stroke-linecap=\"round\"><path d=\"M40 70 H220 L200 320 H60 Z\"/><path d=\"M30 70 H230\"/><path d=\"M150 70 L190 10\"/></g></svg></div>\n<div class=\"pc\"><span class=\"n\">no.2</span><svg viewBox=\"0 0 260 340\"><g fill=\"none\" stroke=\"#121315\" stroke-width=\"7\" stroke-linecap=\"round\"><path d=\"M40 70 H220 L200 320 H60 Z\"/><path d=\"M30 70 H230\"/><path d=\"M150 70 L190 10\"/></g></svg></div>\n<div class=\"pc hi\"><span class=\"n\">no.1</span><svg viewBox=\"0 0 260 340\"><g fill=\"none\" stroke=\"#121315\" stroke-width=\"7\" stroke-linecap=\"round\"><path d=\"M40 70 H220 L200 320 H60 Z\"/><path d=\"M30 70 H230\"/><path class=\"straw\" d=\"M150 70 L190 10\" stroke=\"#FC5400\" stroke-width=\"9\"/></g></svg></div>\n</div></div></div>",
  "timeline": "const glide = gsap.customEase('M0,0 C0.12,0.9 0.2,1 1,1');\n\nconst head = gsap.splitText('.h', {type: 'words', mask: 'words'});\nconst cards = q('.pc');\ntl.from(cards, {y: 80, opacity: 0, duration: 0.7, ease: glide, stagger: 0.06}, 0);\ntl.from(head.words, {yPercent: 110, duration: 0.75, ease: glide, stagger: 0.07}, 0.1);\ntl.to(cards, {rotation: (i) => (i - 2) * 9, x: (i) => (i - 2) * 70, duration: 1.1, ease: 'power3.inOut', stagger: 0.04}, 0.8);\ntl.from(q('.sub'), {y: 20, opacity: 0, duration: 0.6, ease: glide}, 1.2);\ntl.to(cards[4], {y: -70, rotation: 0, x: 0, scale: 1.06, duration: 0.8, ease: 'back.out(1.4)'}, 2.2);\ntl.fromTo(q('.straw'), {drawSVG: '0% 100%'}, {drawSVG: '0% 100%', duration: 0.01}, 2.2);\ntl.to(cards.slice(0, 4), {opacity: 0.55, duration: 0.6, ease: 'power2.out'}, 2.3);"
 },
 "stat_ring": {
  "title": "숫자 — 고리가 차오르는 결론 숫자",
  "archetype": "stat_ring",
