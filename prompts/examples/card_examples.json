  "duration": 6.0,
  "html": "<div class=\"card\" data-card-id=\"st\"><style>\n.card[data-card-id=\"st\"] .root{width:100%;height:100%;position:relative;overflow:hidden;background:var(--paper)}\n.card[data-card-id=\"st\"] .stage{position:absolute;inset:0}\n.card[data-card-id=\"st\"] .kicker{position:absolute;left:150px;top:150px;font-family:var(--font-body);font-weight:600;font-size:30px;letter-spacing:.14em;color:var(--ink-soft)}\n.card[data-card-id=\"st\"] .kicker b{color:var(--ink);font-weight:800;border-bottom:4px solid var(--accent)}\n.card[data-card-id=\"st\"] .h{position:absolute;left:142px;top:250px;margin:0;font-family:var(--font-head);font-weight:800;font-size:184px;line-height:1.02;letter-spacing:-.045em;color:var(--ink)}\n.card[data-card-id=\"st\"] .h .line{display:block;white-space:nowrap}\n.card[data-card-id=\"st\"] .h em{font-family:var(--font-italic);font-style:italic;font-weight:400;letter-spacing:-.01em;color:var(--accent-deep)}\n.card[data-card-id=\"st\"] svg.u{position:absolute;left:150px;top:666px;width:980px;height:60px;overflow:visible}\n.card[data-card-id=\"st\"] svg.cups{position:absolute;left:1240px;top:300px;width:560px;height:520px;overflow:visible}\n.card[data-card-id=\"st\"] .note{position:absolute;left:150px;top:760px;width:900px;font-family:var(--font-body);font-weight:500;font-size:40px;line-height:1.4;color:var(--ink-soft)}\n.card[data-card-id=\"st\"] .tag{position:absolute;right:150px;top:150px;font-family:var(--font-italic);font-style:italic;font-size:40px;color:var(--ink-soft)}\n.card[data-card-id=\"st\"] .ring{position:absolute;right:-180px;top:240px;width:760px;height:760px;border-radius:50%;border:2px solid var(--paper-line)}\n.card[data-card-id=\"st\"] .dot{position:absolute;right:120px;top:830px;width:30px;height:30px;border-radius:50%;background:var(--accent)}\n</style><div class=\"root\"><div class=\"stage\">\n<div class=\"ring\"></div><div class=\"dot\"></div>\n<div class=\"kicker\">CH.2 · <b>고착</b></div>\n<div class=\"tag\">Design Fixation</div>\n<h1 class=\"h\"><span class=\"line\">처음 본 것이</span><span class=\"line\">답을 <em>잡는다</em></span></h1>\n<svg class=\"u\" viewBox=\"0 0 980 60\"><path class=\"ul\" d=\"M4 34 C 220 12, 520 50, 976 22\" fill=\"none\" stroke=\"var(--accent)\" stroke-width=\"10\" stroke-linecap=\"round\"/></svg>\n<p class=\"note\">예시를 본 학생들의 시안은 그 예시를 닮았다.</p>\n<svg class=\"cups\" viewBox=\"0 0 560 520\"><g fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"9\">\n<g class=\"cup c3\" stroke=\"rgba(18,19,21,.22)\"><path d=\"M300 120 H500 L478 470 H322 Z\" fill=\"var(--paper)\"/><path d=\"M290 120 H510\"/><path d=\"M420 120 L460 50\"/></g>\n<g class=\"cup c2\" stroke=\"rgba(18,19,21,.45)\"><path d=\"M190 120 H390 L368 470 H212 Z\" fill=\"var(--paper)\"/><path d=\"M180 120 H400\"/><path d=\"M310 120 L350 50\"/></g>\n<g class=\"cup c1\" stroke=\"var(--ink)\"><path d=\"M80 120 H280 L258 470 H102 Z\" fill=\"var(--paper)\"/><path d=\"M70 120 H290\"/><path d=\"M200 120 L240 50\" stroke=\"var(--accent)\"/></g></g></svg>\n</div></div></div>",
  "timeline": "const lines = gsap.splitText('.h .line', {type: 'words', mask: 'words'});\nconst glide = gsap.customEase('M0,0 C0.12,0.9 0.2,1 1,1');\ntl.from(q('.ring'), {scale: 0.86, opacity: 0, duration: 1.2, ease: glide}, 0);\ntl.from(q('.kicker, .tag'), {y: 18, opacity: 0, duration: 0.6, ease: glide, stagger: 0.08}, 0.05);\ntl.from(lines.words, {yPercent: 112, duration: 0.8, ease: glide, stagger: 0.07}, 0.1);\ntl.fromTo(q('.ul'), {drawSVG: '0% 0%'}, {drawSVG: '0% 100%', duration: 0.9, ease: 'power2.inOut'}, 1.0);\ntl.from(q('.dot'), {scale: 0, duration: 0.5, ease: 'back.out(1.6)'}, 1.15);\ntl.from(q('.note'), {y: 24, opacity: 0, duration: 0.7, ease: glide}, 1.5);\ntl.to(q('.stage'), {scale: 1.025, duration: 4.6, ease: 'none', transformOrigin: '30% 40%'}, 0.2);\ntl.to(q('.dot'), {x: -40, y: -30, duration: 3.2, ease: 'sine.inOut'}, 1.6);\ntl.fromTo(q('.cups .c1 path'), {drawSVG: '0% 0%'}, {drawSVG: '0% 100%', duration: 0.9, ease: 'power2.inOut', stagger: 0.1}, 0.3);\ntl.from(q('.cups .c2'), {x: -110, opacity: 0, duration: 0.8, ease: glide}, 1.2);\ntl.from(q('.cups .c3'), {x: -220, opacity: 0, duration: 0.8, ease: glide}, 1.45);"
 },
 "object_callouts": {
