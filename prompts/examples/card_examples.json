  "html": "<div class=\"card\" data-card-id=\"bt\"><style>\n.card[data-card-id=\"bt\"] .root{width:100%;height:100%;position:relative;overflow:hidden;background:var(--paper)}\n.card[data-card-id=\"bt\"] .c{position:absolute;border-radius:34px;background:var(--white);box-shadow:0 26px 60px -30px rgba(18,19,21,.30),0 2px 5px rgba(18,19,21,.05);overflow:hidden}\n.card[data-card-id=\"bt\"] .c.dark{background:var(--ink)}\n.card[data-card-id=\"bt\"] .c.acc{background:var(--accent)}\n.card[data-card-id=\"bt\"] .t{position:absolute;left:44px;top:40px;font-family:var(--font-body);font-weight:600;font-size:28px;letter-spacing:.12em;color:var(--ink-soft)}\n.card[data-card-id=\"bt\"] .dark .t{color:rgba(244,244,242,.66)}\n.card[data-card-id=\"bt\"] .acc .t{color:var(--ink)}\n.card[data-card-id=\"bt\"] .h{position:absolute;left:44px;bottom:46px;margin:0;font-family:var(--font-head);font-weight:800;font-size:84px;line-height:1.02;letter-spacing:-.04em;color:var(--ink)}\n.card[data-card-id=\"bt\"] .h em{font-family:var(--font-italic);font-style:italic;font-weight:400;color:var(--accent-deep)}\n.card[data-card-id=\"bt\"] .n{position:absolute;left:40px;bottom:36px;font-family:var(--font-head);font-weight:900;font-size:150px;line-height:1;letter-spacing:-.06em;color:#F4F4F2}\n.card[data-card-id=\"bt\"] .q{position:absolute;left:44px;right:44px;bottom:44px;font-family:var(--font-body);font-weight:600;font-size:40px;line-height:1.35;color:var(--ink)}\n.card[data-card-id=\"bt\"] .chips{position:absolute;left:40px;bottom:40px;display:flex;flex-wrap:wrap;gap:14px;width:520px}\n.card[data-card-id=\"bt\"] .chip{font-family:var(--font-body);font-weight:600;font-size:30px;padding:12px 24px;border-radius:999px;background:var(--paper);color:var(--ink)}\n.card[data-card-id=\"bt\"] svg.sk{position:absolute;right:30px;top:30px;width:330px;height:330px}\n</style><div class=\"root\">\n<div class=\"c c1\" style=\"left:110px;top:100px;width:900px;height:520px\"><div class=\"t\">CH.2 · 근거</div>\n<svg class=\"sk\" viewBox=\"0 0 330 330\"><g fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"6\" stroke-linecap=\"round\"><path class=\"s\" d=\"M70 90 h150 l-14 190 h-122 z\"/><path class=\"s\" d=\"M60 90 h170\"/><path class=\"s\" d=\"M150 90 l40 -60\" stroke=\"var(--accent)\"/></g></svg>\n<h2 class=\"h\">예시는<br><em>출발선</em>이 된다</h2></div>\n<div class=\"c c2 dark\" style=\"left:1040px;top:100px;width:390px;height:520px\"><div class=\"t\">시안 일치율</div><div class=\"n\">71%</div></div>\n<div class=\"c c3 acc\" style=\"left:1460px;top:100px;width:350px;height:520px\"><div class=\"t\">1991</div><div class=\"q\" style=\"color:var(--ink)\">공학 전공<br>학생 대상</div></div>\n<div class=\"c c4\" style=\"left:110px;top:650px;width:1060px;height:290px\"><div class=\"q\">“예시의 특징은 금지해도 다시 나타났다.”</div></div>\n<div class=\"c c5\" style=\"left:1200px;top:650px;width:610px;height:290px\"><div class=\"t\">반복된 특징</div><div class=\"chips\"><span class=\"chip\">빨대</span><span class=\"chip\">뚜껑 홈</span><span class=\"chip\">원통</span></div></div>\n</div></div>",
  "timeline": "const glide = gsap.customEase('M0,0 C0.12,0.9 0.2,1 1,1');\nconst cells = q('.c');\ntl.fromTo(cells, {clipPath: 'inset(12% 12% 12% 12% round 34px)', scale: 0.94, opacity: 0},\n  {clipPath: 'inset(0% 0% 0% 0% round 34px)', scale: 1, opacity: 1, duration: 0.9, ease: glide, stagger: 0.09}, 0);\nconst head = gsap.splitText('.c1 .h', {type: 'words', mask: 'words'});\ntl.from(head.words, {yPercent: 110, duration: 0.7, ease: glide, stagger: 0.06}, 0.35);\ntl.fromTo(q('.sk .s'), {drawSVG: '0% 0%'}, {drawSVG: '0% 100%', duration: 0.9, ease: 'power2.inOut', stagger: 0.1}, 0.6);\ntl.from(q('.c2 .n'), {yPercent: 40, opacity: 0, duration: 0.8, ease: glide}, 0.7);\ntl.from(q('.chip'), {y: 20, opacity: 0, scale: 0.9, duration: 0.45, ease: 'back.out(1.4)', stagger: 0.1}, 1.2);\ntl.from(q('.c4 .q'), {y: 24, opacity: 0, duration: 0.7, ease: glide}, 1.0);\ntl.to(q('.c1'), {y: -6, duration: 3.5, ease: 'sine.inOut'}, 2.0);\ntl.to(q('.c5'), {y: 6, duration: 3.5, ease: 'sine.inOut'}, 2.0);"
 },
