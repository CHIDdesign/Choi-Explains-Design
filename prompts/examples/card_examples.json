  "html": "<div class=\"card\" data-card-id=\"db\"><style>\n.card[data-card-id=\"db\"] .root{width:100%;height:100%;position:relative;overflow:hidden;background:var(--paper)}\n.card[data-card-id=\"db\"] .kick{position:absolute;left:140px;top:132px;font-family:var(--font-body);font-weight:600;font-size:30px;letter-spacing:.14em;color:var(--ink-soft)}\n.card[data-card-id=\"db\"] .big{position:absolute;left:132px;top:180px;font-family:var(--font-head);font-weight:900;font-size:300px;line-height:1;letter-spacing:-.06em;color:var(--ink)}\n.card[data-card-id=\"db\"] .big small{font-size:140px;color:var(--accent-deep)}\n.card[data-card-id=\"db\"] .cap{position:absolute;left:142px;top:520px;width:620px;font-family:var(--font-body);font-size:40px;font-weight:500;line-height:1.4;color:var(--ink)}\n.card[data-card-id=\"db\"] .cap em{font-family:var(--font-italic);font-style:italic;color:var(--accent-deep)}\n.card[data-card-id=\"db\"] .chart{position:absolute;left:900px;top:150px;width:880px;height:700px}\n.card[data-card-id=\"db\"] .axis{position:absolute;left:0;bottom:90px;width:880px;height:4px;background:var(--ink);transform-origin:0 50%}\n.card[data-card-id=\"db\"] .bar{position:absolute;bottom:94px;width:150px;border-radius:18px 18px 4px 4px;background:var(--ink);transform-origin:50% 100%}\n.card[data-card-id=\"db\"] .bar.hi{background:var(--accent)}\n.card[data-card-id=\"db\"] .val{position:absolute;width:150px;text-align:center;font-family:var(--font-head);font-weight:800;font-size:52px;color:var(--ink)}\n.card[data-card-id=\"db\"] .val.hi{color:var(--accent-deep)}\n.card[data-card-id=\"db\"] .lab{position:absolute;bottom:20px;width:150px;text-align:center;font-family:var(--font-body);font-weight:600;font-size:32px;color:var(--ink-soft)}\n</style><div class=\"root\">\n<div class=\"kick\">JANSSON &amp; SMITH · 1991</div>\n<div class=\"big\"><span class=\"num\" data-anim=\"count-up\" data-anim-from=\"0\" data-anim-to=\"71\" data-anim-at=\"0.3\" data-anim-duration=\"1.6\" data-anim-format=\".0f\">71</span><small>%</small></div>\n<p class=\"cap\">예시를 본 쪽은 시안의 대부분에 <em>그 특징</em>을 그대로 넣었다</p>\n<div class=\"chart\">\n<div class=\"axis\"></div>\n<div class=\"bar b1\" style=\"left:40px;height:250px\"></div><div class=\"val\" style=\"left:40px;bottom:364px\">27%</div><div class=\"lab\" style=\"left:40px\">예시 없음</div>\n<div class=\"bar b2 hi\" style=\"left:250px;height:520px\"></div><div class=\"val hi\" style=\"left:250px;bottom:634px\">71%</div><div class=\"lab\" style=\"left:250px\">예시 봄</div>\n<div class=\"bar b3\" style=\"left:460px;height:330px\"></div><div class=\"val\" style=\"left:460px;bottom:444px\">38%</div><div class=\"lab\" style=\"left:460px\">경고 후</div>\n<div class=\"bar b4\" style=\"left:670px;height:180px\"></div><div class=\"val\" style=\"left:670px;bottom:294px\">19%</div><div class=\"lab\" style=\"left:670px\">스케치 먼저</div>\n</div></div></div>",
  "timeline": "const glide = gsap.customEase('M0,0 C0.12,0.9 0.2,1 1,1');\ntl.from(q('.kick'), {y: 16, opacity: 0, duration: 0.5, ease: glide}, 0);\ntl.from(q('.big'), {yPercent: 18, opacity: 0, duration: 0.8, ease: glide}, 0.05);\ntl.from(q('.axis'), {scaleX: 0, duration: 0.7, ease: 'power3.inOut'}, 0.1);\ntl.from(q('.lab'), {y: 16, opacity: 0, duration: 0.45, ease: glide, stagger: 0.08}, 0.25);\ntl.from(q('.bar'), {scaleY: 0, duration: 1.0, ease: 'expo.out', stagger: 0.14}, 0.45);\ntl.from(q('.val'), {y: 20, opacity: 0, duration: 0.5, ease: glide, stagger: 0.14}, 0.95);\ntl.from(q('.cap'), {y: 20, opacity: 0, duration: 0.7, ease: glide}, 1.6);\ntl.to(q('.b2'), {scaleY: 1.03, duration: 0.6, ease: 'sine.inOut', yoyo: true, repeat: 1}, 2.6);"
 },
 "bento": {
