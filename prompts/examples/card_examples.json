  "html": "<div class=\"card\" data-card-id=\"ba\"><style>\n.card[data-card-id=\"ba\"] .root{width:100%;height:100%;position:relative;overflow:hidden;background:var(--paper)}\n.card[data-card-id=\"ba\"] .h{position:absolute;left:140px;top:96px;margin:0;font-family:var(--font-head);font-weight:800;font-size:96px;letter-spacing:-.04em;color:var(--ink)}\n.card[data-card-id=\"ba\"] .h em{font-family:var(--font-italic);font-style:italic;font-weight:400;color:var(--accent-deep)}\n.card[data-card-id=\"ba\"] .board{position:absolute;left:140px;top:250px;width:1640px;height:620px;border-radius:40px;background:var(--white);box-shadow:0 34px 80px -34px rgba(18,19,21,.32),0 2px 6px rgba(18,19,21,.06);overflow:hidden}\n.card[data-card-id=\"ba\"] .layer{position:absolute;inset:0}\n.card[data-card-id=\"ba\"] .after{background:#FFF4EE}\n.card[data-card-id=\"ba\"] svg{position:absolute;left:0;top:0;width:1640px;height:620px}\n.card[data-card-id=\"ba\"] .tag{position:absolute;top:36px;font-family:var(--font-body);font-weight:700;font-size:30px;letter-spacing:.14em;padding:10px 22px;border-radius:999px}\n.card[data-card-id=\"ba\"] .tag.b{left:40px;background:var(--paper);color:var(--ink)}\n.card[data-card-id=\"ba\"] .tag.a{right:40px;background:var(--accent);color:var(--ink)}\n.card[data-card-id=\"ba\"] .handle{position:absolute;top:0;left:820px;width:6px;height:620px;background:var(--ink)}\n.card[data-card-id=\"ba\"] .knob{position:absolute;left:-31px;top:279px;width:68px;height:68px;border-radius:50%;background:var(--ink);box-shadow:0 10px 24px rgba(18,19,21,.3)}\n.card[data-card-id=\"ba\"] .knob:before,.card[data-card-id=\"ba\"] .knob:after{content:\"\";position:absolute;top:24px;border:10px solid transparent}\n.card[data-card-id=\"ba\"] .knob:before{left:4px;border-right-color:#F7F8F6}\n.card[data-card-id=\"ba\"] .knob:after{right:4px;border-left-color:#F7F8F6}\n</style><div class=\"root\">\n<h2 class=\"h\">다시 그린 건 <em>질문</em>이었다</h2>\n<div class=\"board\">\n<div class=\"layer bef