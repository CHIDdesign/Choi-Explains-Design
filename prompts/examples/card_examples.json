  "style": "swiss",
  "duration": 6.5,
  "html": "<div class=\"card\" data-card-id=\"sr\"><style>\n.card[data-card-id=\"sr\"] .root{width:100%;height:100%;position:relative;overflow:hidden;background:var(--paper)}\n.card[data-card-id=\"sr\"] svg.r{position:absolute;left:150px;top:110px;width:760px;height:760px}\n.card[data-card-id=\"sr\"] .num{position:absolute;left:150px;top:300px;width:760px;text-align:center;font-family:var(--font-head);font-weight:900;font-size:240px;line-height:1;letter-spacing:-.06em;color:var(--ink)}\n.card[data-card-id=\"sr\"] .num small{font-size:110px;color:var(--accent-deep)}\n.card[data-card-id=\"sr\"] .unit{position:absolute;left:150px;top:560px;width:760px;text-align:center;font-family:var(--font-body);font-weight:600;font-size:34px;letter-spacing:.12em;color:var(--ink-soft)}\n.card[data-card-id=\"sr\"] .h{position:absolute;left:1040px;top:200px;width:760px;margin:0;font-family:var(--font-head);font-weight:800;font-size:92px;line-height:1.05;letter-spacing:-.04em;color:var(--ink)}\n.card[data-card-id=\"sr\"] .h em{font-family:var(--font-italic);font-style:italic;font-weight:400;color:var(--accent-deep)}\n.card[data-card-id=\"sr\"] .row{position:absolute;left:1044px;width:720px;display:flex;justify-content:space-between;align-items:baseline;padding:22px 0;border-top:3px solid var(--ink);font-family:var(--font-body);font-size:38px;font-weight:600;color:var(--ink)}\n.card[data-card-id=\"sr\"] .row b{font-family:var(--font-head);font-weight:800;font-size:56px}\n</style><div class=\"root\">\n<svg class=\"r\" viewBox=\"0 0 760 760\"><circle cx=\"380\" cy=\"380\" r=\"330\" fill=\"none\" stroke=\"rgba(18,19,21,.08)\" stroke-width=\"34\"/>\n<circle class=\"arc\" cx=\"380\" cy=\"380\" r=\"330\" fill=\"none\" stroke=\"var(--accent)\" stroke-width=\"34\" stroke-linecap=\"round\" transform=\"rotate(-90 380 380)\"/></svg>\n<div class=\"num\"><span data-anim=\"count-up\" data-anim-from=\"0\" data-anim-to=\"71\" data-anim-at=\"0.3\" data-anim-duration=\"1.6\" data-anim-format=\".0f\">71</span><small>%</small></div>\n<div class=\"unit\">시안 일치율</div>\n<h2 class=\"h\">셋 중 둘이<br><em>예시</em>를 닮았다</h2>\n<div class=\"row\" style=\"top:520px\"><span>예시 없음</span><b>27%</b></div>\n<div class=\"row\" style=\"top:640px\"><span>예시 봄</span><b style=\"color:var(--accent-deep)\">71%</b></div>\n</div></div>",
  "timeline": "const glide = gsap.customEase('M0,0 C0.12,0.9 0.2,1 1,1');\n\nconst head = gsap.splitText('.h', {type: 'words', mask: 'words'});\ntl.fromTo(q('.arc'), {drawSVG: '0% 0%'}, {drawSVG: '0% 71%', duration: 1.6, ease: 'power2.out'}, 0.3);\ntl.from(q('.unit'), {y: 14, opacity: 0, duration: 0.5, ease: glide}, 0.2);\ntl.from(head.words, {yPercent: 110, duration: 0.75, ease: glide, stagger: 0.07}, 0.4);\ntl.from(q('.row'), {y: 24, opacity: 0, duration: 0.6, ease: glide, stagger: 0.18}, 1.3);"
 },
 "term_split": {
  "title": "용어 — 화자 옆 판에 크게 서는 개념 이름",
  "archetype": "term_split",
  "layout": "split",
  "style": "academic",
  "duration": 6.5,
  "html": "<div class=\"card\" data-card-id=\"te\"><style>\n.card[data-card-id=\"te\"] .root{width:100%;height:100%;position:relative;overflow:hidden;background:var(--white);border-radius:40px}\n.card[data-card-id=\"te\"] .k{position:absolute;left:84px;top:84px;font-family:var(--font-body);font-weight:700;font-size:28px;letter-spacing:.16em;color:var(--ink-soft)}\n.card[data-card-id=\"te\"] .k:before{content:\"\";display:inline-block;width:14px;height:14px;border-radius:50%;background:var(--accent);margin-right:14px;vertical-align:2px}\n.card[data-card-id=\"te\"] .term{position:absolute;left:80px;top:150px;margin:0;font-family:var(--font-head);font-weight:800;font-size:150px;line-height:1;letter-spacing:-.05em;color:var(--ink)}\n.card[data-card-id=\"te\"] .en{position:absolute;left:88px;top:318px;font-family:var(--font-italic);font-style:italic;font-size:58px;color:var(--accent-deep)}\n.card[data-card-id=\"te\"] .def{position:absolute;left:86px;top:430px;width:900px;margin:0;font-family:var(--font-body);font-weight:600;font-size:42px;line-height:1.42;color:var(--ink)}\n.card[data-card-id=\"te\"] .def .mark{position:relative;display:inline-block}\n.card[data-card-id=\"te\"] svg.circ{position:absolute;left:-26px;top:-18px;width:calc(100% + 52px);height:calc(100% + 36px);overflow:visible}\n.card[data-card-id=\"te\"] .rule{position:absolute;left:86px;top:640px;width:900px;height:3px;background:var(--ink);transform-origin:0 50%}\n.card[data-card-id=\"te\"] .src{position:absolute;left:86px;top:666px;font-family:var(--font-body);font-weight:500;font-size:30px;color:var(--ink-soft)}\n</style><div class=\"root\">\n<div class=\"k\">용어</div>\n<h2 class=\"term\">디자인 고착</h2>\n<div class=\"en\">Design Fixation</div>\n<p class=\"def\">처음 본 안에 <span class=\"mark\">생각이 붙잡혀<svg class=\"circ\" viewBox=\"0 0 300 100\" preserveAspectRatio=\"none\"><path class=\"c\" d=\"M150 8 C 260 6, 296 30, 292 52 C 288 82, 210 94, 140 92 C 60 90, 6 74, 8 50 C 10 24, 70 8, 160 10\" fill=\"none\" stroke=\"var(--accent)\" stroke-width=\"5\" stroke-linecap=\"round\" vector-effect=\"non-scaling-stroke\"/></svg></span> 다른 길을 못 보는 상태</p>\n<div class=\"rule\"></div>\n<div class=\"src\">Jansson &amp; Smith, Design Studies 1991</div>\n</div></div>",
  "timeline": "const glide = gsap.customEase('M0,0 C0.12,0.9 0.2,1 1,1');\n\nconst t = gsap.splitText('.term', {type: 'chars', mask: 'chars'});\ntl.from(q('.k'), {x: -16, opacity: 0, duration: 0.5, ease: glide}, 0);\ntl.from(t.chars, {yPercent: 115, duration: 0.7, ease: glide, stagger: 0.04}, 0.05);\ntl.from(q('.en'), {y: 16, opacity: 0, duration: 0.6, ease: glide}, 0.45);\ntl.from(q('.def'), {y: 20, opacity: 0, duration: 0.6, ease: glide}, 0.7);\ntl.fromTo(q('.c'), {drawSVG: '0% 0%'}, {drawSVG: '0% 100%', duration: 0.9, ease: 'power2.inOut'}, 1.6);\ntl.from(q('.rule'), {scaleX: 0, duration: 0.8, ease: 'power3.inOut'}, 1.0);\ntl.from(q('.src'), {opacity: 0, duration: 0.5, ease: glide}, 1.3);"
 },
 "lower_third": {
  "title": "얼굴 위 이름표 — 아래 ⅓ 두 줄",
  "archetype": "lower_third",
  "layout": "overlay",
  "style": "whiteboard",
  "duration": 5.0,
  "html": "<div class=\"card\" data-card-id=\"lt\"><style>\n.card[data-card-id=\"lt\"] .root{width:100%;height:100%;position:relative;overflow:hidden}\n.card[data-card-id=\"lt\"] .wrap{position:absolute;left:40px;top:330px}\n.card[data-card-id=\"lt\"] .row1{display:inline-block;padding:18px 34px;border-radius:24px;background:var(--white);box-shadow:0 18px 40px -18px rgba(18,19,21,.45);font-family:var(--font-head);font-weight:800;font-size:72px;letter-spacing:-.035em;color:var(--ink)}\n.card[data-card-id=\"lt\"] .row1 .hl{background-image:linear-gradient(transparent 60%,var(--accent-soft) 60%);background-repeat:no-repeat;background-size:0% 100%}\n.card[data-card-id=\"lt\"] .row2{display:inline-block;margin-top:14px;padding:14px 28px;border-radius:999px;background:var(--ink);font-family:var(--font-body);font-weight:600;font-size:34px;color:#F4F4F2}\n.card[data-card-id=\"lt\"] .row2 i{font-family:var(--font-italic);font-style:italic;font-weight:400;color:var(--accent-light)}\n</style><div class=\"root\"><div class=\"wrap\">\n<div class=\"row1\">예시는 <span class=\"hl\">출발선</span>이 된다</div><br>\n<div class=\"row2\"><i>Design Fixation</i> · 1991</div>\n</div></div></div>",
  "timeline": "const glide = gsap.customEase('M0,0 C0.12,0.9 0.2,1 1,1');\n\ntl.from(q('.row1'), {xPercent: -12, opacity: 0, duration: 0.6, ease: glide}, 0);\ntl.from(q('.row2'), {xPercent: -18, opacity: 0, duration: 0.55, ease: glide}, 0.2);\ntl.to(q('.hl'), {backgroundSize: '100% 100%', duration: 0.6, ease: 'power2.inOut'}, 0.8);"
 }
